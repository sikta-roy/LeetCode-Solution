class Solution {
    public int[] intersect(int[] nums1, int[] nums2) {
       int c[]=new int[1001];
        for(int i:nums1)
        {
            c[i]++;
        }
        List<Integer> a=new ArrayList<>();
        for(int i:nums2)
        {
            if(c[i]-->0)
            a.add(i);
        }
        return a.stream().mapToInt(Integer::intValue).toArray();
        
        
        
        
        
        
    }
}
