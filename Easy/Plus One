class Solution {
    public int[] plusOne(int[] digits) {
        

        for(int i=digits.length-1;i>=0;i--)
        {
            
            if(digits[i]<9)
            {
                digits[i]=digits[i]+1;
                break;
            }
            else 
            {
                digits[i]=0;
                
            }
        }
        if(digits[0]!=0)
        return digits;
        
        digits=new int[digits.length+1];
        digits[0]=1;
        return digits;
        
        
    }
}

